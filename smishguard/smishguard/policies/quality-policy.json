{
  "description": "Custom code-quality policy enforced by the pipeline on top of SonarCloud's built-in 'Sonar way' quality gate. The SonarCloud free plan cannot host custom quality gates, so these thresholds are applied as code in the Code Quality stage. Each condition lists the metric key used in SonarCloud's Multi-Quality Rule mode first and the classic key second.",
  "conditions": [
    { "label": "Coverage (%)", "metrics": ["coverage"], "op": ">=", "threshold": 85 },
    { "label": "Duplicated lines (%)", "metrics": ["duplicated_lines_density"], "op": "<=", "threshold": 3 },
    { "label": "Maintainability rating (1 = A)", "metrics": ["software_quality_maintainability_rating", "sqale_rating"], "op": "<=", "threshold": 1 },
    { "label": "Reliability rating (1 = A)", "metrics": ["software_quality_reliability_rating", "reliability_rating"], "op": "<=", "threshold": 1 },
    { "label": "Security rating (1 = A)", "metrics": ["software_quality_security_rating", "security_rating"], "op": "<=", "threshold": 1 },
    { "label": "Reliability issues (bugs)", "metrics": ["software_quality_reliability_issues", "bugs"], "op": "<=", "threshold": 0 },
    { "label": "Security issues (vulnerabilities)", "metrics": ["software_quality_security_issues", "vulnerabilities"], "op": "<=", "threshold": 0 },
    { "label": "Maintainability issues (code smells)", "metrics": ["software_quality_maintainability_issues", "code_smells"], "op": "<=", "threshold": 25 }
  ],
  "trendMetrics": ["coverage", "duplicated_lines_density", "ncloc", "cognitive_complexity"]
}
