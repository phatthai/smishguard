{
  "name": "smishguard",
  "version": "1.0.0",
  "description": "SmishGuard: a scam SMS (smishing) risk-check and community reporting service with a lightweight web UI.",
  "main": "src/server.js",
  "private": true,
  "license": "MIT",
  "author": "Tien Phat Thai",
  "repository": {
    "type": "git",
    "url": "https://github.com/phatthai/smishguard.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:ci": "node --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --ci --coverage",
    "test:e2e": "node node_modules/jest/bin/jest.js --config jest.e2e.config.js --ci",
    "lint": "eslint .",
    "lint:ci": "node scripts/ci/lint.js",
    "sonar": "node node_modules/@sonar/scan/bin/sonar-scanner.js"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sonar/scan": "5.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "supertest": "7.3.0"
  }
}
