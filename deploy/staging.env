# Staging: the test environment every build is deployed to first.
# Non-secret settings only. JWT_SECRET is injected from the Jenkins credential "jwt-secret-staging".
APP_ENV=staging
HOST_PORT=3001
LOG_LEVEL=debug
JWT_EXPIRES_IN=2h
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
CHECK_RATE_LIMIT_MAX=240
LOGIN_RATE_LIMIT_MAX=30
CPU_LIMIT=0.50
MEMORY_LIMIT=256M
