# Production: promoted to only after every quality, security and staging gate passes.
# Non-secret settings only. JWT_SECRET is injected from the Jenkins credential "jwt-secret-production".
APP_ENV=production
HOST_PORT=3000
LOG_LEVEL=info
JWT_EXPIRES_IN=1h
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
CHECK_RATE_LIMIT_MAX=60
LOGIN_RATE_LIMIT_MAX=10
CPU_LIMIT=1.00
MEMORY_LIMIT=384M
